+"""Tape-driven global-row headers and target selection for the actual CRT query.
+
+Prepared for Jerry Chen / @CubeJerry with substantial OpenAI assistance.
+Apache-2.0. Numeric Entry, ROM execution and copy/query primitives are retained.
+The source and encoded ell are borrowed; the output lease is linear-use.
+"""
+from types import SimpleNamespace
+
+CONTROL_ROLES = ('rows', 'timeline', 'prefix', 'suffix')
+HEADERS = ('h', 'modulus', 'selected_layer', 'offsets')
+QUERY_ROLES = ('coordinate', 'countdown', 'output')
+# This fixed interpreter watchdog is disabled, not calculated from geometry.
+# External verification processes impose wall-clock limits independently.
+NO_WATCHDOG = 1e309
+
+
+def zero_header(target, guide, w):
+    target.emit('L')
+    while guide.read() == w.ONE:
+        target.emit('0')
+        guide.step(1)
+    w.need(guide.read() == w.BLANK, 'guide end')
+    target.write('R')
+    target.rewind()
+    guide.rewind()
+
+
+def increment_header(target, w):
+    target.step(1)
+    while target.read() == '1':
+        target.write('0')
+        target.step(1)
+    w.need(target.read() == '0', 'encoded scalar capacity')
+    target.write('1')
+    target.rewind()
+
+
+class Iterator:
+    """Fresh numeric entry for each active row at the same tape-selected node.
+
+The node's public advancing NodeLease is deliberately not used. The pinned
+Bank Lease retires without advancing; the final row advances the node once.
+"""
+    def __init__(self, w, r, entry, numeric, owner, canonical, nodes, join, rom,
+                 source, ell):
+        self.w, self.r, self.entry_module = w, r, entry
+        self.numeric, self.join, self.rom = numeric, join, rom
+        self.source, self.ell = source, ell
+        w.need(source is not ell and source.cells is not ell.cells, 'distinct borrowed sources')
+        self.node = nodes.Iterator(w, r, entry, numeric, owner, canonical, source)
+        self.controls = {name: entry.Port(w) for name in CONTROL_ROLES}
+        self.service = {name: ['_'] for name in rom.REGS+('arena', 'spool', 'layers', 'rom')+HEADERS}
+        self.headers = {name: join.Tape(self.service[name]) for name in HEADERS}
+        self.queries = {name: join.Tape() for name in QUERY_ROLES}
+        self.produced_rom = join.Tape(self.service['rom'])
+        self.produced_layers = join.Tape(self.service['layers'])
+        self.program = rom.producer_program()  # One input-independent fixed program.
+        self.live, self.closed = False, False
+        self.producer_steps = 0
+        self.setup_cells = 55  # Positive initial cells of52 ROM/header+3 query roles.
+        self._initialize_rows()
+        self._validate_widths()
+
+    def _initialize_rows(self):
+        w, ell, rows = self.w, self.ell, self.controls['rows']
+        w.need(ell.read() == w.ONE, 'positive encoded ell')
+        ell.step(1)
+        w.need(ell.read() == w.ONE, 'encoded ell at least two')
+        ell.rewind()
+        while ell.read() == w.ONE:
+            rows.append(w.ONE)
+            ell.step(1)
+        w.need(ell.read() == w.RIGHT, 'encoded ell framing')
+        ell.rewind()
+        ell.step(1)  # The second pass contributes ell-1 positions.
+        while ell.read() == w.ONE:
+            rows.append(w.ONE)
+            ell.step(1)
+        w.need(ell.read() == w.RIGHT, 'encoded ell return')
+        ell.rewind()
+        rows.append(w.RIGHT)
+        rows.rewind()
+        rows.write(self.r.STEP)
+
+    def _read_width(self):
+        w, r, source, ell = self.w, self.r, self.source, self.ell
+        width = self.node.counters['width']
+        width.clear()
+        w.need(source.read() == r.ROOT, 'axis tag')
+        source.step(1)
+        while source.read() == w.ONE:
+            width.append(w.ONE)
+            source.step(1)
+        w.need(source.read() == r.WORD_END, 'unary width end')
+        source.step(1)
+        width.append(w.RIGHT)
+        width.rewind()
+        w.need(width.read() == w.ONE, 'positive declared width')
+        width.step(1)
+        w.need(width.read() == w.ONE, 'modulus width at least two')
+        width.rewind()
+        while width.read() == w.ONE:
+            w.need(ell.read() == w.ONE, 'width no greater than encoded ell')
+            width.step(1)
+            ell.step(1)
+        short = ell.read() == w.ONE
+        if short:
+            ell.step(1)
+        w.need(ell.read() == w.RIGHT, 'width is ell or ell-1')
+        width.rewind()
+        ell.rewind()
+        return short
+
+    def _field(self, delimiter, visit=None):
+        w, source, width = self.w, self.source, self.node.counters['width']
+        while width.read() == w.ONE:
+            bit = source.read()
+            w.need(bit in (w.ZERO, w.ONE), 'padded field bit')
+            if visit is not None:
+                visit(bit)
+            source.step(1)
+            width.step(1)
+        w.need(width.read() == w.RIGHT and source.read() == delimiter, 'exact padded field')
+        source.step(1)
+        width.rewind()
+
+    def _validate_widths(self):
+        while self.source.read() != self.w.RIGHT:
+            self._read_width()
+            self._field(self.r.WORD_END)
+            self._field(self.r.RECORD_END)
+            self.node.counters['width'].clear()
+        self.source.rewind()
+
+    def _selector(self, short, row_header=None):
+        """Manufacture the exact active-prefix/suffix counts on owned tapes."""
+        w, r = self.w, self.r
+        width, rows = self.node.counters['width'], self.controls['rows']
+        timeline, prefix, suffix = (self.controls[x] for x in ('timeline', 'prefix', 'suffix'))
+        for port in (timeline, prefix, suffix):
+            port.clear()
+        while width.read() == w.ONE:
+            timeline.append(w.ONE)
+            width.step(1)
+        width.rewind()
+        if short:
+            timeline.append(w.ZERO)
+            timeline.append(w.ZERO)
+        width.step(1)
+        while width.read() == w.ONE:
+            timeline.append(w.ONE)
+            width.step(1)
+        width.rewind()
+        timeline.append(w.RIGHT)
+        timeline.rewind()
+        before, active = True, False
+        while rows.read() != w.RIGHT:
+            mark, on = rows.read(), timeline.read()
+            w.need(mark in (w.ONE, r.STEP) and on in (w.ZERO, w.ONE), 'synchronized row shape')
+            if mark == r.STEP:
+                w.need(before, 'one encoded row cursor')
+                before, active = False, on == w.ONE
+            elif on == w.ONE:
+                if before:
+                    prefix.append(w.ONE)
+                    if row_header is not None:
+                        increment_header(row_header, w)
+                else:
+                    suffix.append(w.ONE)
+            rows.step(1)
+            timeline.step(1)
+        w.need(not before and timeline.read() == w.RIGHT, 'complete synchronized rows')
+        for port in (prefix, suffix):
+            port.append(w.RIGHT)
+            port.rewind()
+        rows.rewind()
+        timeline.rewind()
+        return active
+
+    def _clear_selection(self):
+        for name in ('timeline', 'prefix', 'suffix'):
+            self.controls[name].clear()
+
+    def _seek_right(self):
+        w, r, node = self.w, self.r, self.node
+        axis, half = node.counters['axis'], node.counters['half']
+        while axis.read() != r.STEP:
+            w.need(axis.read() == w.ONE, 'node prefix')
+            node._record()
+            axis.step(1)
+        while half.read() == w.ONE:
+            node._record()
+            axis.step(1)
+            half.step(1)
+        w.need(half.read() == w.RIGHT, 'selected left half')
+        half.rewind()
+
+    def _finish_scan(self):
+        self.source.rewind()
+        self.node.counters['axis'].rewind()
+        self.node.counters['half'].rewind()
+
+    def _any_active(self):
+        self._seek_right()
+        w, half, axis = self.w, self.node.counters['half'], self.node.counters['axis']
+        active = False
+        while half.read() == w.ONE:
+            short = self._read_width()
+            active = self._selector(short) or active
+            self._field(self.r.WORD_END)
+            self._field(self.r.RECORD_END)
+            self.node.counters['width'].clear()
+            self._clear_selection()
+            half.step(1)
+            axis.step(1)
+        w.need(half.read() == w.RIGHT, 'selected right half')
+        self._finish_scan()
+        return active
+
+    def next(self):
+        self.w.need(not self.live, 'current row must close')
+        if self.closed:
+            return None
+        self.live = True
+        if not self._any_active():
+            return Lease(self, None, None)
+        node = self.node
+        node.live = True
+        bridge = SimpleNamespace(RowEntry=node._entry)
+        numeric = node.bank.open(self.r, self.numeric, bridge, self.source, node.guards,
+                                 None, None, None, None, None)
+        self._query(numeric.actual)
+        return Lease(self, numeric, self.queries['output'])
+
+    def _query(self, actual):
+        w, r, guide = self.w, self.r, actual.guide
+        headers, result = self.headers, actual.result['stream']
+        coordinate, countdown, output = (self.queries[name] for name in QUERY_ROLES)
+        output.emit('L')
+        self._seek_right()
+        half, axis, width = (self.node.counters[name] for name in ('half', 'axis', 'width'))
+        while half.read() == w.ONE:
+            short = self._read_width()
+            zero_header(headers['h'], guide, w)
+            zero_header(headers['selected_layer'], guide, w)
+            while width.read() == w.ONE:
+                increment_header(headers['h'], w)
+                width.step(1)
+            width.rewind()
+            active = self._selector(short, headers['selected_layer'])
+            if active:
+                headers['modulus'].emit('L')
+            def modulus_bit(bit):
+                if active:
+                    w.need(guide.read() == w.ONE, 'modulus fits current guide')
+                    headers['modulus'].emit('1' if bit == w.ONE else '0')
+                    guide.step(1)
+            self._field(r.WORD_END, modulus_bit)
+            if active:
+                while guide.read() == w.ONE:
+                    headers['modulus'].emit('0')
+                    guide.step(1)
+                w.need(guide.read() == w.BLANK, 'modulus padding complete')
+                guide.rewind()
+                headers['modulus'].write('R')
+                headers['modulus'].rewind()
+            coordinate.emit('L')
+            if active:
+                countdown.emit('L')
+            def coordinate_bit(bit):
+                symbol = '1' if bit == w.ONE else '0'
+                coordinate.emit(symbol)
+                if active:
+                    countdown.emit(symbol)
+            self._field(r.RECORD_END, coordinate_bit)
+            coordinate.write('R')
+            coordinate.rewind()
+            w.need(result.read() == r.ROOT, 'actual offset record')
+            result.step(1)
+            if active:
+                countdown.write('R')
+                countdown.rewind()
+                self.join.copy_numeric_field(result, headers['offsets'], guide, w, r.WORD_END, '|')
+                run = self.rom.execute(self.program, self.service, max_steps=NO_WATCHDOG)
+                w.need(run['status'] == 'accept', 'unchanged ROM accepts encoded headers')
+                w.need(all(head == 0 for head in run['heads'].values()), 'ROM heads returned')
+                self.producer_steps += run['steps']  # Observer meter; never selects control.
+                bit = self.join.select_row_bit(self.produced_rom, countdown)
+                prefix, suffix = self.controls['prefix'], self.controls['suffix']
+                coordinate.step(1)
+                while prefix.read() == w.ONE and suffix.read() == w.ONE:
+                    coordinate.step(1)
+                    prefix.step(1)
+                    suffix.step(1)
+                old = coordinate.read()
+                w.need(old in ('0', '1'), 'selected target inside coordinate')
+                coordinate.write('1' if (old == '1') != (bit == '1') else '0')
+                coordinate.rewind()
+                self.produced_layers.erase()
+                self.produced_rom.erase()
+                for tape in headers.values():
+                    tape.erase()
+            else:
+                self.join.skip_numeric_field(result, guide, w, r.WORD_END)
+                headers['h'].erase()
+                headers['selected_layer'].erase()
+            self.join.skip_numeric_field(result, guide, w, r.WORD_END)
+            w.need(result.read() == r.RECORD_END, 'actual offset record end')
+            result.step(1)
+            coordinate.step(1)
+            while coordinate.read() != 'R':
+                output.emit(coordinate.read())
+                coordinate.step(1)
+            coordinate.rewind()
+            coordinate.erase()
+            output.emit('|')
+            width.clear()
+            self._clear_selection()
+            half.step(1)
+            axis.step(1)
+        w.need(half.read() == w.RIGHT and result.read() == w.RIGHT, 'complete selected right stream')
+        result.rewind()
+        self._finish_scan()
+        output.write('R')
+        output.rewind()
+
+    def _advance_row(self):
+        w, rows = self.w, self.controls['rows']
+        while rows.read() != self.r.STEP:
+            w.need(rows.read() == w.ONE, 'row cursor prefix')
+            rows.step(1)
+        rows.write(w.ONE)
+        rows.step(1)
+        finished = rows.read() == w.RIGHT
+        if finished:
+            rows.rewind()
+        else:
+            w.need(rows.read() == w.ONE, 'next global row')
+        rows.write(self.r.STEP)
+        rows.rewind()
+        return finished
+
+    def _clear_pending(self, last):
+        w, r, axis = self.w, self.r, self.node.counters['axis']
+        seen = False
+        while axis.read() != w.RIGHT:
+            if axis.read() == r.VALUE:
+                w.need(not seen and not last, 'one pending next-node marker')
+                axis.write(w.ONE)
+                seen = True
+            else:
+                w.need(axis.read() in (w.ONE, r.STEP), 'retired current-node marker')
+            axis.step(1)
+        w.need(seen != last, 'pending marker agrees with node boundary')
+        axis.rewind()
+
+    def close(self):
+        self.w.need(not self.live and not self.closed, 'retired row iterator closes once')
+        self.node.close()
+        for port in self.controls.values():
+            port.retire()
+        self.closed = True
+
+
+class Lease:
+    """One current row continuation; old host handles are outside physical scope."""
+    def __init__(self, iterator, numeric, output):
+        self.iterator, self.numeric, self.output = iterator, numeric, output
+        self.closed = False
+
+    def close(self):
+        it = self.iterator
+        it.w.need(not self.closed, 'current row closes once')
+        last = False
+        if self.numeric is not None:
+            last = self.numeric.actual.last
+            self.output.erase()
+            self.numeric.close()  # Retires actual bank without node advance.
+            it.node.live = False
+        self.closed, it.live = True, False
+        if it._advance_row():
+            it.w.need(self.numeric is not None, 'last row is active on every admitted target')
+            it.node._advance(last)  # Exactly once after the node's final row.
+            if it.node.closed:
+                for port in it.controls.values():
+                    port.retire()
+                it.closed = True
+        elif self.numeric is not None:
+            it._clear_pending(last)
