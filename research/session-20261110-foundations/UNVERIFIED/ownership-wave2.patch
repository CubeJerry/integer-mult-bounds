diff --git a/research/fixed-dimension-bit-coefficients/check_consumer.py b/research/fixed-dimension-bit-coefficients/check_consumer.py
new file mode 100644
index 00000000..d7230d8a
--- /dev/null
+++ b/research/fixed-dimension-bit-coefficients/check_consumer.py
@@ -0,0 +1,226 @@
+"""Independent small-block algebra and literal encoded-consumer executions.
+
+Fixture serialization and expected arithmetic are outside the runtime. Runtime
+Word.inspect is forbidden, including for N>64. This is not a full B0 dispatcher.
+"""
+from fractions import Fraction as F
+from hashlib import sha256
+import json
+from math import gcd
+from pathlib import Path
+import sys
+from types import ModuleType
+
+HERE = Path(__file__).resolve().parent
+
+
+def load(path):
+    name = "fixed_dimension_consumer_source"
+    old = sys.modules.get(name)
+    module = ModuleType(name)
+    module.__file__ = str(path)
+    sys.modules[name] = module
+    try:
+        exec(compile(path.read_bytes(),str(path),"exec"),module.__dict__)
+    finally:
+        if old is None:
+            sys.modules.pop(name,None)
+        else:
+            sys.modules[name]=old
+    return module
+
+
+C = load(HERE/"consumer.py")
+
+
+def need(condition, label):
+    if not condition:
+        raise ValueError(label)
+
+
+def identity(n):
+    return [[F(i==j) for j in range(n)] for i in range(n)]
+
+
+def fixtures(n):
+    preparation = identity(n)
+    preparation[0][n-1] = F(1,2)
+    template = C.Template(3,1,tuple(map(tuple,preparation)))
+    specs = {}
+    for code,block in enumerate((((1,1),(1,2)),((0,1),(1,1)),((1,2),(1,0)))):
+        low=[[int(i==j) for j in range(n)] for i in range(n)]
+        for i,x in enumerate((0,n-1)):
+            for j,y in enumerate((0,n-1)):
+                low[x][y]=block[i][j]
+        # The compiled preparation is unit triangular. The first projector
+        # pivot is good for the first and third low class, bad for the second.
+        specs[code]=C.Specification(code,template,tuple(map(tuple,low)),code!=1)
+    return specs
+
+
+def projector(spec,high,modulus):
+    """Closed 2x2 adjugate formula on the nontrivial extreme-coordinate block.
+
+    Other coordinates are identity in the header and zero in the rank-one
+    projector. No source matrix preparation or elimination is imported.
+    """
+    n=len(high); axes=(0,n-1)
+    g=[[ (spec.low[i][j]+spec.template.q*high[i][j])%modulus for j in axes] for i in axes]
+    s=[[ (z.numerator*pow(z.denominator,-1,modulus))%modulus
+         for j in axes for z in (spec.template.preparation[i][j],)] for i in axes]
+    h=[[sum(g[i][k]*s[k][j] for k in range(2))%modulus for j in range(2)] for i in range(2)]
+    a,b=h[0]; c,d=h[1]; det=(a*d-b*c)%modulus
+    inv=pow(det,-1,modulus)
+    block=[[a*d*inv%modulus,-a*b*inv%modulus],[c*d*inv%modulus,-c*b*inv%modulus]]
+    out=[[0]*n for _ in range(n)]
+    for i,x in enumerate(axes):
+        for j,y in enumerate(axes): out[x][y]=block[i][j]
+    return out
+
+
+def fallback_diagonal(p,modulus):
+    """Separate integer row-operation oracle for the fixed residual matrix."""
+    n=len(p); d=2*n
+    a=[[0]*d for _ in range(d)]
+    for i in range(n):
+        for j in range(n):
+            z=(int(i==j)-p[i][j])%modulus
+            a[i][j]=z; a[d-1-i][d-1-j]=z
+            a[i][d-1-j]=p[i][j]; a[d-1-i][j]=p[i][j]
+    perm=list(range(d))
+    for j in range(d):
+        pivot=next(k for k in range(j,d) if gcd(a[k][j],modulus)==1)
+        a[j],a[pivot]=a[pivot],a[j]; perm[j],perm[pivot]=perm[pivot],perm[j]
+        inv=pow(a[j][j],-1,modulus)
+        for i in range(d):
+            if i!=j:
+                factor=a[i][j]*inv%modulus
+                a[i]=[(x-factor*y)%modulus for x,y in zip(a[i],a[j],strict=True)]
+    need(all(not a[i][j] for i in range(d) for j in range(d) if i!=j),"oracle residual diagonal")
+    return [a[i][i] for i in range(d)],perm
+
+
+def oracle(n,modulus,root_unit,root_size,events,specs,highs,index,coefficient=False):
+    sizes=[root_size]
+    for kind,code,rank,field,reverse,half in events:
+        f=sizes[-1]//n
+        sizes.append(rank*f if kind==0 else f//2 if half else f)
+    def weight(level,coordinate):
+        if level==0: return root_unit
+        kind,code,rank,field,reverse,half=events[level-1]
+        if kind==2: return 1
+        f=sizes[level-1]//n
+        p=projector(specs[code],highs[level-1],modulus)
+        if kind==0:
+            need(rank==1,"fixture rank-one closed oracle")
+            return p[0][0]*weight(level-1,coordinate)%modulus
+        diagonal,perm=fallback_diagonal(p,modulus)
+        column=f-1-coordinate if reverse else coordinate
+        def bank(row):
+            return weight(level-1,row*f+column) if row<n else 1
+        return diagonal[field]*bank(perm[field])*pow(bank(field),-1,modulus)%modulus
+    if not coefficient:
+        return weight(len(events),index)
+    p=projector(specs[2],highs[-1],modulus)
+    f=sizes[-1]//n
+    ell=-p[n-1][0]*pow(p[0][0],-1,modulus)%modulus
+    return ell*weight(len(events),(n-1)*f+index)*pow(weight(len(events),index),-1,modulus)%modulus
+
+
+def run_case(n,width,kinds,*,repeat=1,coefficient=True,short_capacity=False,
+             wrong_field_code=False,truncate_field=False):
+    m=C.build(n); q=3; modulus=q**width; h=len(kinds); root_size=n**(h+1)*2
+    residue_bits=modulus.bit_length()+1; index_bits=root_size.bit_length()+1; code_bits=2
+    bound=C.footprint(n,h,residue_bits,index_bits,code_bits)
+    r=m.words.Arena(residue_bits,capacity=bound['residue_pending']+16)
+    i=m.words.Arena(index_bits,capacity=bound['index_pending']+16)
+    mod=r.input(modulus); ring=m.words.Ring(mod)
+    specs=fixtures(n); events=[]; fields=[]; highs=[]
+    for level,kind in enumerate(kinds):
+        code=0 if kind=='G' else 1
+        field=0 if kind!='P' else (n if level%2 else 0)
+        events.append(({'G':0,'P':1,'U':2}[kind],code,1,field,field>=n,False))
+    for level,code in enumerate([row[1] for row in events]+[2]):
+        high=[[0]*n for _ in range(n)]
+        if width>1:
+            high[n-1][n-1]=(level+1)%q
+            if code==1: high[0][0]=1
+        highs.append(high); fields.append((code,high))
+    program=m.records.Program.fixture(i,r,root_size,2,events,code_bits)
+    raw=m.records.Fields.fixture(i,r,fields,code_bits)
+    if wrong_field_code:
+        raw.tape.cells[1]=1-raw.tape.cells[1]
+    if truncate_field:
+        # Remove one complete final digit word before the first RECORD_END.
+        end=raw.tape.cells.index(m.records.RECORD_END)
+        del raw.tape.cells[end-(residue_bits+1):end]
+    before=(bytes(program.tape.cells),program.tape.head,bytes(raw.tape.cells),raw.tape.head)
+    position=i.input(0)
+    workspace=C.Workspace(m,ring,i)
+    stack_identities=tuple(id(t) for s in workspace.roles for t in (s.tape,s.reverse))
+    start_r,start_i=len(r.live),len(i.live)
+    pending={id(r):start_r,id(i):start_i}
+    original_zero=m.words.Arena.zero
+    original_inspect=m.words.Word.inspect
+    original_tape_init=m.records.Tape.__init__
+    def observed_zero(arena):
+        pending[id(arena)]=max(pending.get(id(arena),0),len(arena.live)+1)
+        return original_zero(arena)
+    def forbidden_inspect(_): raise ValueError('runtime word decoding forbidden')
+    def forbidden_tape_init(_): raise ValueError('fresh continuation tape during callback')
+    m.words.Arena.zero=observed_zero; m.words.Word.inspect=forbidden_inspect
+    m.records.Tape.__init__=forbidden_tape_init
+    if short_capacity:
+        r.capacity=max(len(r.words),len(r.live))+1
+    values=[]; stack_max=[0]*4
+    error=None
+    try:
+        for _ in range(repeat):
+            cb=None
+            try:
+                cb=workspace.open(program,raw,specs,2)
+                output=cb.coefficient(n-1,position) if coefficient else cb.weight(position)
+                cb.close()
+                value=original_inspect(output); r.free(output); values.append(value)
+                for j,tape in enumerate((cb.pending.tape,cb.pending.reverse,cb.values.tape,cb.values.reverse)):
+                    stack_max[j]=max(stack_max[j],len(tape.cells)+1)
+            except ValueError:
+                if cb is not None: cb.abort()
+                raise
+    except ValueError as exc:
+        error=str(exc)
+    finally:
+        m.words.Arena.zero=original_zero; m.words.Word.inspect=original_inspect
+        m.records.Tape.__init__=original_tape_init
+    need(pending[id(r)]<=start_r+bound['residue_pending'],'pre-guard residue demand')
+    need(pending[id(i)]<=start_i+bound['index_pending'],'pre-guard index demand')
+    if short_capacity or wrong_field_code or truncate_field:
+        need(error is not None,'invalid runtime control rejected')
+        return {'control_error':error,'residue_pending':pending[id(r)],'index_pending':pending[id(i)]}
+    need(error is None,'valid encoded run: '+str(error))
+    expected=oracle(n,modulus,2,root_size,events,specs,highs,0,coefficient)
+    need(values==[expected]*repeat,'independent full-ring coefficient')
+    need(before==(bytes(program.tape.cells),program.tape.head,bytes(raw.tape.cells),raw.tape.head),
+         'complete borrowed program/field bytes and heads')
+    need(len(r.live)==start_r and len(i.live)==start_i,'numerical frame closed')
+    need(not workspace.active and stack_identities==tuple(id(t) for s in workspace.roles for t in (s.tape,s.reverse)),
+         'exclusive fixed continuation roles reused')
+    need(len(program.tape.cells)+1<=bound['program_extent'],'full Program backing')
+    need(len(raw.tape.cells)+1<=bound['fields_extent'],'full N-squared Fields backing')
+    need(sum(stack_max)<=bound['four_stack_extents'],'four historical stack extents')
+    residue_backing=(len(r.words)+1)*(residue_bits+2)
+    index_backing=(len(i.words)+1)*(index_bits+2)
+    need(len(r.words)<=start_r+bound['residue_pending'] and len(i.words)<=start_i+bound['index_pending'],
+         'allocated slots retain erased history')
+    i.free(position); ring.close(); r.free(mod)
+    need(not r.live and not i.live,'complete numerical retirement')
+    return {'N':n,'w':width,'kinds':kinds,'repetitions':repeat,'value':expected,
+            'residue_pending':pending[id(r)],'index_pending':pending[id(i)],
+            'residue_backing':residue_backing,'index_backing':index_backing,
+            'four_stack_backing':stack_max,'program_backing':len(program.tape.cells)+1,
+            'fields_backing':len(raw.tape.cells)+1,
+            'source_changes':m.edit_count}
+
+
+if __name__=='__main__':
+    print(json.dumps(run_case(2,2,'GP'),sort_keys=True))
diff --git a/research/fixed-dimension-bit-coefficients/consumer.py b/research/fixed-dimension-bit-coefficients/consumer.py
new file mode 100644
index 00000000..101f057c
--- /dev/null
+++ b/research/fixed-dimension-bit-coefficients/consumer.py
@@ -0,0 +1,191 @@
+"""Compile one fixed-dimensional instance of the retained encoded consumer.
+
+Dimension and finite label widths are compile-time constants. Runtime field
+digits, coordinates and depths stay in the unchanged binary word machine.
+Prepared for CubeJerry with substantial OpenAI Codex assistance. Apache-2.0.
+"""
+from dataclasses import dataclass
+from fractions import Fraction
+from hashlib import sha256
+import json
+from pathlib import Path
+from types import ModuleType, SimpleNamespace
+import sys
+
+PACKAGE = Path(__file__).resolve().parent
+ROOT = PACKAGE.parents[1]
+SOURCE = "research/delayed-cover-chronological-fields/numerical/"
+
+
+def need(condition, label):
+    if not condition:
+        raise ValueError(label)
+
+
+@dataclass(frozen=True)
+class Template:
+    q: int
+    rank: int
+    preparation: tuple[tuple[Fraction, ...], ...]
+
+
+@dataclass(frozen=True)
+class Specification:
+    code: int
+    template: Template
+    low: tuple[tuple[int, ...], ...]
+    good: bool
+
+
+def changes(dimension):
+    """Every specialization site is explicit and checked once against its pin."""
+    n = dimension
+    bits = max(16, (2*n).bit_length())
+    return {
+        "words": [
+            ("0 <= constant <= 128", f"0 <= constant <= {2*n}"),
+        ],
+        "records": [
+            ("FINITE_BITS = 16", f"FINITE_BITS = {bits}"),
+            ("f = size//64", f"f = size//{n}"),
+            ("out = [[read_word(self.tape, self.residue_arena) for _ in range(64)] for _ in range(64)]",
+             f"out = [[read_word(self.tape, self.residue_arena) for _ in range({n})] for _ in range({n})]"),
+            ("len(high) == 64 and all(len(row) == 64 for row in high)",
+             f"len(high) == {n} and all(len(row) == {n} for row in high)"),
+        ],
+        "matrices": [
+            ("0 < rows <= 128 and 0 < columns <= 256", f"0 < rows <= {2*n} and 0 < columns <= {4*n}"),
+            ("size <= 128 and all(len(row) == size for row in matrix)",
+             f"size <= {2*n} and all(len(row) == size for row in matrix)"),
+            ("size <= 64", f"size <= {n}"),
+        ],
+        "controller": [
+            ("0 < limit <= 128", f"0 < limit <= {2*n}"),
+            ("for _ in range(8):", f"for _ in range({n.bit_length()+1}):"),
+            ("self.index.literal(64)", f"self.index.literal({n})"),
+            ("1 <= rank <= 42", f"1 <= rank < {n}"),
+            ("field < 127 and reverse == (field >= 64)",
+             f"field < {2*n-1} and reverse == (field >= {n})"),
+            ("if row < 64:", f"if row < {n}:"),
+            ("0 < target_row < 64", f"0 < target_row < {n}"),
+            ("allow_fallback=False, leaf=False):",
+             "allow_fallback=False, leaf=False, stack_roles=None):"),
+            ("self.pending, self.values = Stack(index_arena, self.residue), Stack(index_arena, self.residue)",
+             "need(stack_roles is not None and len(stack_roles) == 2, 'two borrowed continuation roles')\n"
+             "        self.pending, self.values = stack_roles\n"
+             "        need(all(s.index_arena is index_arena and s.residue_arena is self.residue and s.empty() "
+             "for s in stack_roles), 'closed matching continuation workspace')"),
+        ],
+    }
+
+
+def build(dimension: int):
+    """Return actual encoded modules specialized before any runtime input.
+
+    This is a source compiler, not a runtime matrix-oracle substitution.
+    The arithmetic/record/stack algorithms retain their source bytes apart
+    from the listed static bounds. The two listed interface edits take
+    the two Stack objects from an exclusive reusable workspace.
+    """
+    need(type(dimension) is int and dimension >= 2, "fixed dimension >=2")
+    pins = {r["path"]: r["sha256"] for r in json.loads((PACKAGE/"SOURCES.json").read_text())["files"]}
+    edits = changes(dimension)
+    originals = {}
+    transformed = {}
+    for name in ("words", "records", "matrices", "controller"):
+        path = SOURCE + name + ".py"
+        raw = (ROOT/path).read_bytes()
+        need(sha256(raw).hexdigest() == pins[path], "source drift: " + path)
+        originals[name] = raw.decode()
+        text = originals[name]
+        for old, new in edits.get(name, []):
+            need(text.count(old) == 1, "specialization site count: " + old)
+            text = text.replace(old, new, 1)
+        transformed[name] = text
+    # Imports in the unchanged source use these four module names. Restore the
+    # process module registry after compilation so distinct N instances do not
+    # alias one another or a caller's previously loaded source cohort.
+    saved = {name: sys.modules.get(name) for name in transformed}
+    modules = {}
+    try:
+        for name, text in transformed.items():
+            module = ModuleType(name)
+            module.__file__ = str(ROOT/(SOURCE+name+".py"))
+            sys.modules[name] = module
+            exec(compile(text, module.__file__, "exec"), module.__dict__)
+            modules[name] = module
+    finally:
+        for name, old in saved.items():
+            if old is None:
+                sys.modules.pop(name, None)
+            else:
+                sys.modules[name] = old
+    return SimpleNamespace(dimension=dimension,
+                           finite_bits=max(16,(2*dimension).bit_length()),
+                           edit_count=sum(map(len, edits.values())),
+                           source_hashes={k:sha256(v.encode()).hexdigest() for k,v in originals.items()},
+                           specialized_hashes={k:sha256(v.encode()).hexdigest() for k,v in transformed.items()},
+                           **modules)
+
+
+class Workspace:
+    """One real, exclusive four-tape continuation inventory across callbacks.
+
+    Residue/index contexts are fixed for this workspace. A callback borrows
+    Program/Fields, and returns these stack roles before a later call reuses
+    them. Erased historical suffixes remain in the same Tape objects.
+    """
+    def __init__(self, modules, ring, index_arena):
+        self.modules, self.ring, self.index = modules, ring, index_arena
+        self.roles = tuple(modules.records.Stack(index_arena,ring.arena) for _ in range(2))
+        self.active = False
+        workspace = self
+        base = self.modules.controller.Callback
+        class BoundCallback(base):
+            def close(self):
+                need(workspace.active, "live callback lease")
+                super().close()
+                workspace.active=False
+
+            def abort(self):
+                try:
+                    super().abort()
+                finally:
+                    workspace.active=False
+        self.callback_type = BoundCallback
+
+    def open(self, program, fields, specifications, current_code, *, allow_fallback=False, leaf=False):
+        need(not self.active, "exclusive continuation workspace")
+        need(program.index_arena is self.index and fields.index_arena is self.index and
+             program.residue_arena is self.ring.arena and fields.residue_arena is self.ring.arena,
+             "one encoded numerical context")
+        self.active = True
+        try:
+            return self.callback_type(self.ring,self.index,program,fields,specifications,current_code,
+                                      allow_fallback=allow_fallback,leaf=leaf,stack_roles=self.roles)
+        except Exception:
+            # This flag has no numerical payload and never substitutes for
+            # the inherited abort/rollback or input-validity contracts.
+            self.active=False
+            raise
+
+
+def footprint(dimension, depth, residue_bits, index_bits, code_bits):
+    """Conservative explicit extents; input entry history is charged separately.
+
+    The numerical bounds are additional pending Word demand over legal entry
+    residents, before a capacity guard. No successful execution is assumed.
+    """
+    need(type(dimension) is int and dimension >= 2, "fixed dimension")
+    need(all(type(v) is int and v >= 0 for v in (depth,residue_bits,index_bits,code_bits)),
+         "integer footprint inputs")
+    need(residue_bits >= 2 and index_bits >= dimension.bit_length()+1 and code_bits >= 1,
+         "word/label extent")
+    n,h,r,i,q = dimension,depth,residue_bits,index_bits,code_bits
+    f = max(16,(2*n).bit_length())
+    t = max(2*i+4,r+3)
+    return {"residue_pending":16*n*n+128,"index_pending":128,
+            "program_extent":2*i+r+10+h*(q+5*f+2*i+12),
+            "fields_extent":(h+1)*(q+n*n*(r+1)+2)+4,
+            "four_stack_extents":(4*h+12)*t+16,
+            "finite_label_bits":f}
